# Local development (npm run dev) — use a SEPARATE Supabase project from production.
# Never put production keys here. Vercel holds production env vars.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_LOCAL_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: powers VISA checker + trip assistant + stay ranking
GEMINI_API_KEY=your-gemini-api-key
